	partition Courses = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(CheminDonnees & "\faits_courses.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"Date", type date}, {"ChauffeurID", type text}, {"CoursesDemandees", Int64.Type}, {"CoursesTerminees", Int64.Type}, {"CoursesAnnulees", Int64.Type}, {"CA", type number}, {"Km", type number}, {"SommeNotes", type number}, {"CA_Carte", type number}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table

