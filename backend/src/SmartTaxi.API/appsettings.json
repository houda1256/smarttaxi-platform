{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "SmartTaxi",
    "Audience": "SmartTaxi",
    "ExpiryMinutes": 60
  },
  "RefreshToken": {
    "LifetimeMinutes": 43200,
    "SessionLifetimeDays": 90
  },
  "EmailVerification": {
    "TokenLifetimeHours": 24,
    "ResendIntervalSeconds": 60
  },
  "PhoneVerification": {
    "OtpLifetimeMinutes": 5,
    "MaxAttempts": 5,
    "ResendIntervalSeconds": 60,
    "LockoutMinutes": 15
  },
  "PasswordReset": {
    "TokenLifetimeHours": 1
  },
  "TwoFactor": {
    "RecoveryCodeCount": 10,
    "ChallengeTokenLifetimeMinutes": 5,
    "TotpDigits": 6,
    "TotpStepSeconds": 30,
    "TotpDriftSteps": 1,
    "Issuer": "SmartTaxi"
  },
  "Security": {
    "RevokeOtherSessionsOnPasswordChange": true
  },
  "DocumentStorage": {
    "RootPath": "storage/documents",
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": [ "application/pdf", "image/jpeg", "image/png" ]
  },
  "DocumentExpiration": {
    "ReminderLeadDays": 30
  },
  "ReferralActivation": {
    "RequireEmailVerified": true,
    "RequirePhoneVerified": false,
    "MinAccountAgeDays": 0
  },
  "LoginLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "AuthCritical": { "PermitLimit": 10, "WindowSeconds": 60, "QueueLimit": 0 },
    "OtpAndChallenge": { "PermitLimit": 5, "WindowSeconds": 300, "QueueLimit": 0 },
    "PublicRead": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 },
    "AuthenticatedGeneral": { "PermitLimit": 120, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 },
    "AdminMutation": { "PermitLimit": 30, "WindowSeconds": 60, "SegmentsPerWindow": 6, "QueueLimit": 0 },
    "SensitiveMutation": { "TokenLimit": 10, "TokensPerPeriod": 1, "ReplenishmentPeriodSeconds": 6, "AutoReplenishment": true, "QueueLimit": 0 }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
